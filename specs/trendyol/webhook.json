                      "type": "string",
                      "enum": [
                        "CREATED",
                        "PICKING",
                        "INVOICED",
                        "SHIPPED",
                        "CANCELLED",
                        "DELIVERED",
                        "UNDELIVERED",
                        "RETURNED",
                        "UNSUPPLIED",
                        "AWAITING",
                        "UNPACKED",
                        "AT_COLLECTION_POINT",
                        "VERIFIED"
                      ]
                    }
                  }
                }
              },
              "example": {
                "url": "https://testwebhook.com",
                "username": "user",
                "password": "password",
                "authenticationType": "API_KEY",
                "apiKey": "123456",
                "subscribedStatuses": [
                  "CREATED",
                  "PICKING"
                ]
              }
            }
          }
        },
