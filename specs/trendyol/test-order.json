                        "description": "Mahalle"
                      },
                      "phone": {
                        "type": "string",
                        "description": "Telefon numarası"
                      },
                      "postalCode": {
                        "type": "string",
                        "description": "Posta kodu"
                      },
                      "email": {
                        "type": "string",
                        "description": "E-posta adresi"
                      },
                      "invoiceTaxNumber": {
                        "type": "string",
                        "description": "Vergi numarası (kurumsal fatura için gerekli)"
