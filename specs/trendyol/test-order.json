                      "invoiceFirstName",
                      "invoiceLastName",
                      "phone",
                      "email"
                    ],
                    "properties": {
                      "addressText": {
                        "type": "string",
                        "description": "Fatura adresi"
                      },
                      "city": {
                        "type": "string",
                        "description": "Şehir"
                      },
                      "company": {
