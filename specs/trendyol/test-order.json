                      },
                      "city": {
                        "type": "string",
                        "description": "Şehir"
                      },
                      "company": {
                        "type": "string",
                        "description": "Firma adı"
                      },
                      "district": {
                        "type": "string",
                        "description": "İlçe"
                      },
                      "latitude": {
                        "type": "string",
                        "description": "Enlem"
                      },
                      "longitude": {
                        "type": "string",
                        "description": "Boylam"
                      },
                      "neighborhood": {
                        "type": "string",
                        "description": "Mahalle"
                      },
                      "phone": {
                        "type": "string",
                        "description": "Telefon numarası"
                      },
                      "postalCode": {
                        "type": "string",
                        "description": "Posta kodu"
                      },
                      "shippingFirstName": {
                        "type": "string",
                        "description": "Teslimat adı"
                      },
                      "shippingLastName": {
                        "type": "string",
                        "description": "Teslimat soyadı"
                      },
                      "email": {
                        "type": "string",
                        "description": "E-posta adresi"
                      }
                    }
                  },
                  "commercial": {
                    "type": "boolean",
                    "description": "Kurumsal fatura durumu (true ise invoiceAddress içinde company, invoiceTaxNumber ve invoiceTaxOffice doldurulmalıdır)",
                    "default": false
                  },
                  "microRegion": {
                    "type": "string",
                    "description": "Mikro ihracat bölgesi (AZ veya GULF)",
                    "enum": [
                      "AZ",
                      "GULF"
                    ]
                  }
                }
              },
              "example": {
